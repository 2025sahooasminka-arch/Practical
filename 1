1: Create the project folder and starter files
cd ~/devops-practicals
mkdir -p StudentManagement
cd StudentManagement
@ cat > index.html <<'EOF'
<!doctype html>
<html><head><title>Student Management</title></head><body>
<h1>Student Management</h1><p>Manage student records.</p>
</body></html>
EOF

@ cat > students.txt <<'EOF'
101, Asha, Information Technology
102, Rahul, Computer Engineering
103, Meera, Electronics
EOF

cat > README.md <<'EOF'
# Student Management
A simple project used for practicing Git version control.
EOF

echo "Starter project for Git initialization, tracking, commits, modifications and comparison." > README.txt

ls -l
Step 2: Initialize the repository and show configuration
bash
git init
git config user.name
git config user.email
git config --list
ls -a
Step 3: Track, stage and commit
bash
git status
git add index.html
git status
git add .
git status
git commit -m "Initial commit: Student Management starter files"
Step 4: Modify files, commit, view history
bash
echo "104, Arth, Information Technology" >> students.txt

cat > index.html <<'EOF'
<!doctype html>
<html><head><title>Student Management</title></head><body>
<h1>Student Management</h1><p>Manage student records - add, view and update students.</p>
</body></html>
EOF

git status
git add students.txt index.html
git commit -m "Add student 104 and update description"
git log
git log --oneline
Step 5: Compare changes
bash
echo "105, Neha, AI and Data Science" >> students.txt
git diff
git add students.txt
git diff --staged
git commit -m "Add student 105"
git diff HEAD~1 HEAD
git diff HEAD~2 HEAD -- students.txt
Step 6: Final status
bash
git status
git log --oneline
